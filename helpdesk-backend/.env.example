# Variables de entorno para Backend (Django)
SECRET_KEY=tu-clave-secreta-super-segura
DEBUG=False
ALLOWED_HOSTS=tu-backend.onrender.com,.vercel.app
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app

# PostgreSQL (opcional - para producción en Render/Railway)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tu_bd
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_HOST=tu_host
DB_PORT=5432

# Cloudinary (opcional - adjuntos de tickets en la nube en vez de disco local)
# Crea una cuenta gratis en https://cloudinary.com/ y copia la "API Environment variable"
# desde el dashboard (Settings > API Keys). Sin esta variable, los adjuntos se guardan
# en disco local (media/) y no persisten entre deploys de Render.
CLOUDINARY_URL=cloudinary://tu_api_key:tu_api_secret@tu_cloud_name